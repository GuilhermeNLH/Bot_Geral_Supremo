# Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Trello API credentials (from https://trello.com/power-ups/admin)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_TOKEN=your_trello_token_here

# Trello board ID (the long ID in the board URL)
TRELLO_BOARD_ID=your_trello_board_id_here

# Optional: restrict bot commands to a specific Discord guild ID for faster sync
# DISCORD_GUILD_ID=your_guild_id_here
